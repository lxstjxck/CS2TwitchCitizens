<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="CS2TwitchCitizens.Mod.local.props" Condition="Exists('CS2TwitchCitizens.Mod.local.props')" />
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CS2TwitchCitizens.Mod</AssemblyName>
    <Version>0.7.0</Version>
    <TwitchClientId Condition="'$(TwitchClientId)' == ''">$([System.Environment]::GetEnvironmentVariable('CS2TWITCHCITIZENS_CLIENT_ID'))</TwitchClientId>
    <ManagedPath Condition="'$(ManagedPath)' == '' and '$(CS2ManagedDir)' != ''">$(CS2ManagedDir)</ManagedPath>
    <CS2ToolPath Condition="'$(CS2ToolPath)' == ''">$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))</CS2ToolPath>
    <CS2ToolPath Condition="'$(CS2ToolPath)' == '' and Exists('$(ManagedPath)/../Content/Game/.ModdingToolchain/Mod.props')">$(ManagedPath)/../Content/Game/.ModdingToolchain</CS2ToolPath>
  </PropertyGroup>
  <Import Project="$(CS2ToolPath)/Mod.props" Condition="Exists('$(CS2ToolPath)/Mod.props')" />
  <Import Project="$(CS2ToolPath)/Mod.targets" Condition="Exists('$(CS2ToolPath)/Mod.targets')" />
  <Target Name="RequireOfficialToolchain" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(CS2ToolPath)/Mod.props') or !Exists('$(CS2ToolPath)/Mod.targets')" Text="Official CS2 Mod.props/Mod.targets not found. Install the Code Mod Toolchain or set CS2ToolPath." />
  </Target>
  <Target Name="RequireGameAssemblies" BeforeTargets="ResolveReferences" Condition="'$(ManagedPath)' == '' or !Exists('$(ManagedPath)/Game.dll')">
    <Error Text="Set ManagedPath to the game's Cities2_Data/Managed directory containing Game.dll." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="../CS2TwitchCitizens.Commands/CS2TwitchCitizens.Commands.csproj" />
    <ProjectReference Include="../CS2TwitchCitizens.Twitch/CS2TwitchCitizens.Twitch.csproj" />
    <Reference Include="System.Net.Http"><Private>false</Private></Reference>
    <Reference Include="Game"><HintPath>$(ManagedPath)/Game.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Entities"><HintPath>$(ManagedPath)/Unity.Entities.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Collections"><HintPath>$(ManagedPath)/Unity.Collections.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Mathematics"><HintPath>$(ManagedPath)/Unity.Mathematics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedPath)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.Core"><HintPath>$(ManagedPath)/Colossal.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.Mathematics"><HintPath>$(ManagedPath)/Colossal.Mathematics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.Logging"><HintPath>$(ManagedPath)/Colossal.Logging.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.UI.Binding"><HintPath>$(ManagedPath)/Colossal.UI.Binding.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="GenerateTwitchClientId" BeforeTargets="CoreCompile">
    <Error Condition="'$(TwitchClientId)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(TwitchClientId)', '^[a-zA-Z0-9]+$'))" Text="TwitchClientId must contain only letters and digits." />
    <WriteLinesToFile File="$(IntermediateOutputPath)TwitchClientId.g.cs" Lines="namespace CS2TwitchCitizens.Mod { internal static class TwitchClientId { internal const string Value = &quot;$(TwitchClientId)&quot;%3B } }" Overwrite="true" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)TwitchClientId.g.cs" /></ItemGroup>
  </Target>
</Project>
